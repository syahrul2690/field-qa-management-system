# Dependencies
node_modules/

# Build outputs
dist/
build/

# Environment files
.env
*.env.local

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Git
.git/
.gitignore

# IDE
.vscode/
.idea/

# Uploads (runtime data)
uploads/

# Tests
*.test.ts
*.spec.ts
__tests__/
coverage/

# Docs
# NOTE: Knowledge_Base/ is intentionally NOT excluded — the backend reads it at
# runtime for AI-assisted review (see knowledgeBaseService.ts). It lives at the
# repo root, not under backend/, so this file only matters if this Dockerfile is
# ever built with context=backend/ directly; the root .dockerignore is what
# governs the actual `context: .` build used by docker-compose.
*.md
Business Process Memory/
tasks/

# Prisma migrations SQL are kept, but not needed in backend image
# (we use prisma migrate deploy or copy schema only)
prisma/migrations/*.sql
