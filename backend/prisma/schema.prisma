// ============================================================
// Field QA Management System — Prisma Schema
// ============================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum InstitutionType {
  OWNER
  CONSULTANT
  VENDOR
}

enum Role {
  ADMIN
  PIC_PROJECT
  PIC_CONSULTANT // Consultant institution coordinator — assigns review team
  VENDOR
  REVIEWER
  CHECKER
  APPROVER
  VIEWER
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ProjectType {
  TRANSMISSION
  DISTRIBUTION
  SUBSTATION
  GENERATION
  OTHER
}

enum ProjectUrgency {
  NORMAL
  RUPTL
  KERAWANAN_SISTEM
  KINERJA_KORPORAT
}

enum DocumentSection {
  FIELD_ITP
  PROCEDURE
  WORK_METHOD
}

enum ReviewStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED_A
  APPROVED_WITH_COMMENTS_B
  REJECTED_C
  SUPERSEDED
}

enum ActivityAction {
  LOGIN
  LOGOUT
  REGISTER
  USER_APPROVED
  USER_REJECTED
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_AMENDED
  BOQ_UPLOADED
  DOCUMENT_UPLOADED
  DOCUMENT_REVISED
  REVIEW_SUBMITTED
  REVIEW_COMMENTED
  REVIEW_CHECKED
  REVIEW_APPROVED
  REVIEW_REJECTED
}

enum QcRole {
  SUPERVISOR
  INSPECTOR
  QC_ENGINEER
  QC_LEAD
}

// PLN hold-point authority codes (per Knowledge_Base/agent.md + 04_Project_Quality_Plan_Field.md).
// A single ITP row can carry a different code per responsible party — see
// ItpItem.sub_code / pp_code / pln_code.
enum InspectionLevel {
  H // Hold Point — work cannot proceed without this party's sign-off
  W // Witness Point — this party should witness (not mandatory hold)
  SW // Spot Witness — periodic/random check by this party
  R // Review — documentation review/verification
  A // Approval — formal engineering approval required
  P // Perform — this party performs & initials the activity itself
}

enum ItpPhase {
  SHOP // Factory / shop inspection
  FIELD // Site / field installation
  COMMISSIONING // Functional & commissioning tests
}

enum ItpCategory {
  SIPIL
  ELEKTRIKAL
  MEKANIKAL
  INSTRUMEN_KONTROL
}

// ============================================================
// IAM DOMAIN
// ============================================================

model Institution {
  id      String          @id @default(uuid())
  name    String
  type    InstitutionType
  address String?
  logo    String? // file path to logo image

  units Unit[]
  users User[]

  project_vendor_visibility ProjectVendorVisibility[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([type])
}

model Unit {
  id             String  @id @default(uuid())
  institution_id String
  parent_unit_id String?
  name           String
  level          Int // 0=Root, 1=Child, 2=Grandchild
  description    String?

  institution Institution @relation(fields: [institution_id], references: [id], onDelete: Cascade)
  parent      Unit?       @relation("UnitHierarchy", fields: [parent_unit_id], references: [id])
  children    Unit[]      @relation("UnitHierarchy")
  users       User[]

  projects_owned Project[] @relation("ProjectOwnerUnit")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([institution_id, parent_unit_id])
  @@index([level])
}

model User {
  id             String     @id @default(uuid())
  email          String     @unique
  password_hash  String
  name           String
  phone          String?
  role           Role
  status         UserStatus @default(PENDING)
  institution_id String
  unit_id        String
  qc_role        QcRole?

  institution Institution @relation(fields: [institution_id], references: [id])
  unit        Unit        @relation(fields: [unit_id], references: [id])

  // Relations
  projects_created    Project[]          @relation("ProjectCreator")
  documents_uploaded  Document[]         @relation("DocumentUploader")
  reviews_as_reviewer DocumentReview[]   @relation("ReviewReviewer")
  reviews_as_checker  DocumentReview[]   @relation("ReviewChecker")
  reviews_as_approver DocumentReview[]   @relation("ReviewApprover")
  review_comments     ReviewComment[]
  ams_letters         AmsLetter[]        @relation("AmsUploader")
  activity_logs       ActivityLog[]
  chat_conversations  ChatConversation[]

  refresh_token         String?
  refresh_token_expires DateTime?

  approved_by String?
  approved_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([email])
  @@index([institution_id, unit_id])
  @@index([status])
}

// ============================================================
// PROJECT DOMAIN
// ============================================================

model Project {
  id                      String         @id @default(uuid())
  name                    String
  description             String?
  contract_signing_date   DateTime
  contract_effective_date DateTime
  duration_days           Int
  warranty_period_days    Int
  project_type            ProjectType
  urgency                 ProjectUrgency @default(NORMAL)
  // JSON: [{ currency: "IDR", amount: 1000000 }, ...]
  nominal_values          Json

  owner_unit_id String
  created_by    String

  owner_unit Unit @relation("ProjectOwnerUnit", fields: [owner_unit_id], references: [id])
  creator    User @relation("ProjectCreator", fields: [created_by], references: [id])

  amendments        ProjectAmendment[]
  vendor_visibility ProjectVendorVisibility[]
  boq_items         BoqItem[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([owner_unit_id])
}

model ProjectAmendment {
  id               String   @id @default(uuid())
  project_id       String
  amendment_no     Int
  amendment_reason String
  effective_date   DateTime

  // Snapshot of values BEFORE this amendment
  previous_duration_days  Int?
  previous_nominal_values Json?

  // New values applied by this amendment
  new_duration_days  Int?
  new_nominal_values Json?

  amended_by String

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())

  @@unique([project_id, amendment_no])
  @@index([project_id])
}

// Controls which vendor institutions can see and submit to a project
model ProjectVendorVisibility {
  id                    String @id @default(uuid())
  project_id            String
  vendor_institution_id String

  project            Project     @relation(fields: [project_id], references: [id], onDelete: Cascade)
  vendor_institution Institution @relation(fields: [vendor_institution_id], references: [id])

  assigned_at DateTime @default(now())
  assigned_by String

  @@unique([project_id, vendor_institution_id])
  @@index([project_id])
  @@index([vendor_institution_id])
}

// ============================================================
// BOQ DOMAIN
// ============================================================

model BoqItem {
  id             String  @id @default(uuid())
  project_id     String
  parent_item_id String?
  level          Int // 1=Area, 2=Sub-area, 3=Equipment, etc.
  item_code      String // User-visible hierarchical code
  system_tag     String  @unique // Auto-generated unique system tag
  title          String
  description    String?
  sort_order     Int     @default(0)

  project  Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  parent   BoqItem?  @relation("BoqHierarchy", fields: [parent_item_id], references: [id])
  children BoqItem[] @relation("BoqHierarchy")

  documents Document[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([project_id, item_code])
  @@index([project_id, parent_item_id])
  @@index([project_id, level])
}

// ============================================================
// DOCUMENT DOMAIN
// ============================================================

model Document {
  id                 String          @id @default(uuid())
  boq_item_id        String
  section            DocumentSection
  doc_number         String
  title              String
  surat_pengantar_no String?
  revision_no        Int             @default(0)
  status             ReviewStatus    @default(DRAFT)
  is_current         Boolean         @default(true)

  boq_item    BoqItem @relation(fields: [boq_item_id], references: [id], onDelete: Cascade)
  uploaded_by String
  uploader    User    @relation("DocumentUploader", fields: [uploaded_by], references: [id])

  files     DocumentFile[]
  reviews   DocumentReview[]
  itp_items ItpItem[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([boq_item_id, section, doc_number, revision_no])
  @@index([boq_item_id, section, is_current])
  @@index([status])
}

model DocumentFile {
  id          String @id @default(uuid())
  document_id String
  file_name   String
  file_path   String // Relative path under uploads dir
  file_size   Int // bytes
  mime_type   String

  document Document @relation(fields: [document_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())

  @@index([document_id])
}

// ============================================================
// WORKFLOW DOMAIN
// ============================================================

model DocumentReview {
  id          String @id @default(uuid())
  document_id String

  reviewer_id String?
  checker_id  String?
  approver_id String?

  // Optimistic locking
  version Int @default(0)

  // SLA
  sla_deadline DateTime?

  // Workflow timestamps — null means that stage is not yet done
  reviewed_at DateTime?
  checked_at  DateTime?
  approved_at DateTime?

  final_status       ReviewStatus?
  comment_sheet_path String? // Path to generated PDF

  // QR verification hash (uuid, unique)
  qr_hash String @unique @default(uuid())

  document Document @relation(fields: [document_id], references: [id], onDelete: Cascade)
  reviewer User?    @relation("ReviewReviewer", fields: [reviewer_id], references: [id])
  checker  User?    @relation("ReviewChecker", fields: [checker_id], references: [id])
  approver User?    @relation("ReviewApprover", fields: [approver_id], references: [id])

  comments            ReviewComment[]
  ams_letter          AmsLetter?
  comment_sheet_items CommentSheetItem[]

  // QR timestamps — set when each stage action completes
  reviewer_qr_at DateTime? // when Reviewer submitted (Prepared By QR stamped)
  checker_qr_at  DateTime? // when Checker approved   (Reviewed By QR stamped)
  approver_qr_at DateTime? // when Approver approved  (Approved By QR stamped)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([document_id])
  @@index([reviewer_id])
  @@index([checker_id])
  @@index([approver_id])
  @@index([final_status])
  @@index([sla_deadline])
}

model AmsLetter {
  id          String    @id @default(uuid())
  review_id   String    @unique
  ams_number  String? // e.g. "AMS/2026/001"
  ams_date    DateTime? // Date stated on the AMS letter
  ams_title   String? // Title/subject of the AMS letter
  file_name   String
  file_path   String // Relative path under uploads dir (e.g., ams/filename.pdf)
  file_size   Int // bytes
  mime_type   String
  uploaded_by String

  review   DocumentReview @relation(fields: [review_id], references: [id], onDelete: Cascade)
  uploader User           @relation("AmsUploader", fields: [uploaded_by], references: [id])

  created_at DateTime @default(now())

  @@index([review_id])
}

model ReviewComment {
  id           String  @id @default(uuid())
  review_id    String
  commenter_id String
  page_ref     String? // e.g., "Page 3, Section 2.1"
  comment      String
  disposition  String? // 'A', 'B', or 'C' — commenter's recommendation

  review    DocumentReview @relation(fields: [review_id], references: [id], onDelete: Cascade)
  commenter User           @relation(fields: [commenter_id], references: [id])

  created_at DateTime @default(now())

  @@index([review_id])
}

model CommentSheetItem {
  id                  String  @id @default(uuid())
  review_id           String
  seq_no              Int // 1-based sequence number
  pln_comment         String // PLN's review comment text
  contractor_response String? // Contractor's response (filled later)

  review DocumentReview @relation(fields: [review_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([review_id, seq_no])
  @@index([review_id])
}

// ============================================================
// ITP INSPECTION ITEMS DOMAIN
// ============================================================

model ItpItem {
  id                  String           @id @default(uuid())
  document_id         String
  seq_no              Int
  activity            String
  acceptance_criteria String?
  reference_standard  String?
  verifying_document  String?
  // Responsibility matrix — the same activity often carries a different hold-point
  // code per party (e.g. Sub: P, PP: R, PLN: H). Null means that party has no role.
  sub_code            InspectionLevel? // Subcontractor
  pp_code             InspectionLevel? // Main Contractor (Pelaksana Pekerjaan)
  pln_code            InspectionLevel? // Client (PT PLN)
  phase               ItpPhase         @default(FIELD)
  category            ItpCategory

  document Document @relation(fields: [document_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([document_id, seq_no])
  @@index([document_id])
}

// ============================================================
// AUDIT DOMAIN
// ============================================================

model ActivityLog {
  id          String         @id @default(uuid())
  user_id     String?
  action      ActivityAction
  entity_type String? // e.g., 'Document', 'Project', 'User'
  entity_id   String? // ID of the affected entity
  metadata    Json? // Additional context (old/new values, etc.)
  ip_address  String?

  user User? @relation(fields: [user_id], references: [id])

  created_at DateTime @default(now())

  @@index([user_id])
  @@index([action])
  @@index([entity_type, entity_id])
  @@index([created_at])
}

// ============================================================
// CHAT DOMAIN
// ============================================================

enum ChatRole {
  USER
  ASSISTANT
  TOOL
}

model ChatConversation {
  id      String  @id @default(uuid())
  user_id String
  title   String?

  // The page the conversation was started from. Advisory context for the
  // assistant only -- every tool call is re-scoped server side, so this is
  // never consulted for authorization.
  project_id String?

  // Identifies the visibility scope in force when the conversation began.
  // If the user's role or institution changes, the mismatch forces a new
  // conversation so tool results captured under a wider scope cannot be
  // replayed into the model.
  scope_fingerprint String

  user     User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_id, updated_at])
  @@index([project_id])
}

model ChatMessage {
  id              String   @id @default(uuid())
  conversation_id String
  seq_no          Int
  role            ChatRole

  // Null on assistant turns that only carry tool calls.
  content String?

  // JSON: the provider tool_calls array, stored verbatim so history can be
  // replayed into the model without reconstruction. Set on ASSISTANT rows.
  tool_calls Json?

  // Set on TOOL rows. tool_name is denormalized for analytics.
  tool_call_id String?
  tool_name    String?

  model_used        String?
  prompt_tokens     Int?
  completion_tokens Int?
  latency_ms        Int?
  error             String?

  conversation ChatConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())

  @@unique([conversation_id, seq_no])
  @@index([conversation_id])
}
