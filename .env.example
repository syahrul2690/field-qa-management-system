# ============================================================
# LOCAL DEVELOPMENT
# ============================================================

# Database
DATABASE_URL="postgresql://qa_user:qa_password@db:5432/field_qa_db"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV=development

# Frontend URL (for CORS and QR verification links)
FRONTEND_URL="http://localhost:5173"
BASE_URL="http://localhost:3000"

# File Storage
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=50

# SLA
DEFAULT_SLA_DAYS=7

# AI (optional)
AI_ENABLED=false
OPENROUTER_API_KEY=""
# Must support tool calling and must not emit reasoning into `content`.
AI_CHAT_MODEL="deepseek/deepseek-v4-flash-0731"
AI_MAX_TOKENS=4096
# Override where the ITP Knowledge_Base/ directory is read from at runtime.
# Leave unset for local dev (auto-resolves to the repo root). The Docker image
# sets this itself (see backend/Dockerfile) — only set it here if running the
# backend outside Docker in an environment where the repo-root auto-resolve breaks.
# KNOWLEDGE_BASE_DIR=""

# Integration API (service-to-service auth for field-qc)
INTEGRATION_API_KEY="generate-a-random-api-key"

# Docker Compose Postgres
POSTGRES_USER=qa_user
POSTGRES_PASSWORD=qa_password
POSTGRES_DB=field_qa_db

# ============================================================
# PRODUCTION (VPS) — USE WITH docker-compose.prod.yml
# Replace 203.0.113.10 with your actual VPS IP address
# ============================================================
# JWT_ACCESS_SECRET="generate-a-64-char-random-string"
# JWT_REFRESH_SECRET="generate-another-64-char-random-string"
# FRONTEND_URL="http://203.0.113.10:8080"
# BASE_URL="http://203.0.113.10:8080"
# POSTGRES_PASSWORD="strong-production-password"
